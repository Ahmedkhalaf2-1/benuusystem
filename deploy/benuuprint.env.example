# /etc/benuuprint/benuuprint.env — PRODUCTION environment for Benuuprint ERP.
# Template only: copy to the VPS, fill in, then
#   sudo chown root:benuuprint /etc/benuuprint/benuuprint.env
#   sudo chmod 0640 /etc/benuuprint/benuuprint.env
# Never commit the filled-in file. Never reuse the local development password.
# There must be NO .env file inside /opt/benuuprint (source, releases) on the server.

# PostgreSQL — a dedicated role and database for this app only.
# Generate the password on the VPS:  openssl rand -hex 32   (hex = URL-safe)
# The app refuses to start with the local development password or a *_test database.
DATABASE_URL="postgresql://benuuprint_app:REPLACE_WITH_GENERATED_HEX@127.0.0.1:5432/benuuprint?schema=public"

# Local port the app listens on (127.0.0.1 only). Pick one that is free:
#   sudo ss -ltnp | grep ':3000 '
# and use the same port in the Caddy site block.
PORT=3000

# Session cookies are Secure (__Host- prefix) automatically in production.
# Leave this unset on the VPS. Never set it to "false" there.
# SESSION_COOKIE_SECURE="true"

# NODE_ENV=production is set by the systemd unit; no need to repeat it here.
