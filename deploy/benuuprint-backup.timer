# /etc/systemd/system/benuuprint-backup.timer — daily backup at 03:15 server time.
#   sudo systemctl enable --now benuuprint-backup.timer
#   systemctl list-timers benuuprint-backup.timer
[Unit]
Description=Daily Benuuprint ERP database backup

[Timer]
OnCalendar=*-*-* 03:15:00
RandomizedDelaySec=10m
# Runs at next boot if the server was off at 03:15.
Persistent=true

[Install]
WantedBy=timers.target
