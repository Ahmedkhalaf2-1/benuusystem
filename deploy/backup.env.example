# /etc/benuuprint/backup.env — backup settings (root:benuuprint, 0640).
# Read by benuuprint-backup.service together with benuuprint.env (DATABASE_URL).

# Where encrypted backups are kept on the server (created mode 0700).
BACKUP_DIR=/var/backups/benuuprint

# Local retention in days.
BACKUP_KEEP_DAYS=14

# PUBLIC certificate the backups are encrypted to. The matching private key
# stays OFF the server (owner's password manager + one offline copy).
# See docs/backup-restore.md → "Create the backup key".
BACKUP_RECIPIENT_CERT=/etc/benuuprint/backup-cert.pem

# Optional off-server copy with rclone (configure the remote as the benuuprint
# user first: sudo -u benuuprint rclone config). Example: "offsite:benuuprint-backups"
BACKUP_RCLONE_REMOTE=

# Optional dead-man's switch: pinged on success, "/fail" appended on failure.
# Any service that alerts when pings stop (e.g. a free healthchecks.io check).
BACKUP_HEALTHCHECK_URL=
