// Benuuprint ERP — database schema.
// Table and column names are snake_case in PostgreSQL; models are PascalCase in code.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Coarse roles. Fine-grained permissions are derived from the role in
/// src/lib/auth/permissions.ts, so new permissions do not need a migration.
enum Role {
  OWNER_ADMIN
  STAFF
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String   @db.VarChar(100)
  /// Always stored lowercase and trimmed.
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash")
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions  Session[]
  auditLogs AuditLog[]

  customersCreated Customer[]     @relation("CustomerCreatedBy")
  ordersCreated    Order[]        @relation("OrderCreatedBy")
  paymentsRecorded OrderPayment[] @relation("PaymentRecordedBy")
  paymentsVoided   OrderPayment[] @relation("PaymentVoidedBy")

  suppliersCreated         Supplier[]        @relation("SupplierCreatedBy")
  orderCostsRecorded       OrderCost[]       @relation("OrderCostRecordedBy")
  orderCostsVoided         OrderCost[]       @relation("OrderCostVoidedBy")
  expensesRecorded         GeneralExpense[]  @relation("ExpenseRecordedBy")
  expensesVoided           GeneralExpense[]  @relation("ExpenseVoidedBy")
  outgoingPaymentsRecorded OutgoingPayment[] @relation("OutgoingPaymentRecordedBy")
  outgoingPaymentsVoided   OutgoingPayment[] @relation("OutgoingPaymentVoidedBy")

  workersCreated    Worker[]        @relation("WorkerCreatedBy")
  workdaysRecorded  WorkerWorkday[] @relation("WorkdayRecordedBy")
  workdaysVoided    WorkerWorkday[] @relation("WorkdayVoidedBy")
  workLogsRecorded  WorkerWorkLog[] @relation("WorkLogRecordedBy")
  workLogsVoided    WorkerWorkLog[] @relation("WorkLogVoidedBy")

  stageProgressRecorded ProductionStageProgress[] @relation("StageRecordedBy")
  stageProgressVoided   ProductionStageProgress[] @relation("StageVoidedBy")
  readyRecorded         ProductionReady[]         @relation("ReadyRecordedBy")
  readyVoided           ProductionReady[]         @relation("ReadyVoidedBy")
  deliveriesRecorded    Delivery[]                @relation("DeliveryRecordedBy")
  deliveriesVoided      Delivery[]                @relation("DeliveryVoidedBy")

  @@map("users")
}

/// Server-side sessions. The cookie holds a random token; only its SHA-256
/// hash is stored, so a database leak does not expose usable sessions.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Append-only record of sensitive actions.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Null for actions without a known user (e.g. failed login for an unknown email).
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(64)
  entityType String?  @map("entity_type") @db.VarChar(64)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Failed login attempts, used for rate limiting. Stored in the database so
/// limits hold across restarts and multiple app processes. Old rows are pruned.
model LoginAttempt {
  id        String   @id @default(uuid(7)) @db.Uuid
  email     String   @db.VarChar(254)
  ipAddress String   @map("ip_address") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

// ───────────────────────────── Phase 2: customers & orders ─────────────────────────────

/// Simple named counters (e.g. order numbers). Incremented with
/// UPDATE … RETURNING inside the same transaction as the insert, which makes
/// numbers gapless and safe under concurrency (the row lock serializes writers).
model Counter {
  key   String @id @db.VarChar(64)
  value Int    @default(0)

  @@map("counters")
}

model Customer {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @db.VarChar(120)
  /// As typed (Arabic digits converted to 0-9). Optional, not unique.
  phone       String?  @db.VarChar(30)
  notes       String?  @db.VarChar(1000)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User    @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  orders    Order[]

  @@index([name])
  @@index([phone])
  @@index([createdAt])
  @@map("customers")
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  /// Reserved for the delivery phase; not settable from the UI yet.
  COMPLETED
  CANCELLED
}

enum QuantityUnit {
  PIECE
  SET
  DOZEN
  METER
}

enum PrintOperation {
  DTF
  SCREEN_PRINT
  EMBROIDERY
  /// Garment making (optional required step for garment orders). Phase 5.
  MANUFACTURING
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  INSTAPAY
  OTHER
}

model Order {
  id           String       @id @default(uuid(7)) @db.Uuid
  /// Human order number (#0001), gapless, from the "order_number" counter.
  number       Int          @unique
  customerId   String       @map("customer_id") @db.Uuid
  title        String       @db.VarChar(150)
  productType  String       @map("product_type") @db.VarChar(80)
  material     String       @db.VarChar(80)
  quantity     Int
  unit         QuantityUnit @default(PIECE)
  /// Agreed selling price for the whole order. Outstanding is always derived
  /// (totalPrice − sum of valid payments) and never stored.
  totalPrice   Decimal      @map("total_price") @db.Decimal(12, 2)
  receivedDate DateTime     @map("received_date") @db.Date
  deliveryDate DateTime     @map("delivery_date") @db.Date
  notes        String?      @db.VarChar(2000)
  status       OrderStatus  @default(NEW)
  /// When the last piece was delivered (set/cleared by production automation).
  completedAt  DateTime?    @map("completed_at") @db.Timestamptz(3)
  /// Client-generated key: a retried/double-clicked submit returns the same order.
  idempotencyKey String?    @unique @map("idempotency_key") @db.Uuid
  createdById  String       @map("created_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer  Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User           @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  groups    OrderGroup[]
  payments  OrderPayment[]
  costs     OrderCost[]
  workLogs  WorkerWorkLog[]
  stageProgress ProductionStageProgress[]
  ready         ProductionReady[]
  deliveries    Delivery[]

  @@index([customerId])
  @@index([status, deliveryDate])
  @@index([createdAt])
  @@index([deliveryDate])
  @@map("orders")
}

/// A slice of an order with the same work (e.g. "50 pieces: DTF + embroidery").
/// Quantities of all groups add up to the order quantity.
model OrderGroup {
  id       String  @id @default(uuid(7)) @db.Uuid
  orderId  String  @map("order_id") @db.Uuid
  position Int
  quantity Int
  material String  @db.VarChar(80)
  notes    String? @db.VarChar(500)

  order      Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  operations    OrderGroupOperation[]
  /// Optional garment-size breakdown; when present, sizes add up to `quantity`.
  sizes         OrderGroupSize[]
  workLogs      WorkerWorkLog[]
  stageProgress ProductionStageProgress[]
  ready         ProductionReady[]
  deliveries    Delivery[]

  @@unique([orderId, position])
  @@map("order_groups")
}

/// Zero rows for a group = plain (no printing or embroidery).
model OrderGroupOperation {
  groupId   String         @map("group_id") @db.Uuid
  operation PrintOperation

  group         OrderGroup                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// RESTRICT: a required operation with recorded progress can't be removed.
  stageProgress ProductionStageProgress[]

  @@id([groupId, operation])
  @@map("order_group_operations")
}

/// Customer payments. Never deleted or edited: corrections are made by voiding
/// (owner only, with a reason) so the full history stays visible.
model OrderPayment {
  id             String        @id @default(uuid(7)) @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  paidAt         DateTime      @map("paid_at") @db.Date
  method         PaymentMethod
  notes          String?       @db.VarChar(500)
  /// True for the advance recorded together with the new order.
  isAdvance      Boolean       @default(false) @map("is_advance")
  idempotencyKey String        @unique @map("idempotency_key") @db.Uuid
  recordedById   String        @map("recorded_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt       DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedById     String?       @map("voided_by_id") @db.Uuid
  voidReason     String?       @map("void_reason") @db.VarChar(300)

  order      Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  recordedBy User  @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy   User? @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([paidAt])
  @@map("order_payments")
}

// ───────────────────────────── Phase 3: costs, suppliers & expenses ─────────────────────────────
//
// Three distinct things, never mixed:
//   • OrderCost / GeneralExpense — what something COST (counted once, when recorded,
//     whether paid or not).
//   • OutgoingPayment — CASH that actually left the business, always against exactly
//     one cost or one expense (so a supplier payment can never be counted as a new cost).
//   • Balances (supplier owed, unpaid) — always computed: cost − valid payments.
// Nothing is deleted or edited: corrections are owner-only voids with a reason.

model Supplier {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @db.VarChar(120)
  phone       String?  @db.VarChar(30)
  notes       String?  @db.VarChar(1000)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User        @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  costs     OrderCost[]

  @@index([name])
  @@index([phone])
  @@map("suppliers")
}

enum CostCategory {
  MATERIALS
  PRINTING
  EMBROIDERY
  OUTSOURCED_LABOR
  TRANSPORT
  PACKAGING
  OTHER
}

/// A direct cost of one order (fabric, printing, outside workshop…).
model OrderCost {
  id             String       @id @default(uuid(7)) @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  category       CostCategory
  description    String?      @db.VarChar(200)
  /// Full cost, counted when recorded — paid or not.
  amount         Decimal      @db.Decimal(12, 2)
  costDate       DateTime     @map("cost_date") @db.Date
  supplierId     String?      @map("supplier_id") @db.Uuid
  notes          String?      @db.VarChar(500)
  idempotencyKey String       @unique @map("idempotency_key") @db.Uuid
  recordedById   String       @map("recorded_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt       DateTime?    @map("voided_at") @db.Timestamptz(3)
  voidedById     String?      @map("voided_by_id") @db.Uuid
  voidReason     String?      @map("void_reason") @db.VarChar(300)

  order      Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  supplier   Supplier?         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  recordedBy User              @relation("OrderCostRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy   User?             @relation("OrderCostVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  payments   OutgoingPayment[]

  @@index([orderId])
  @@index([supplierId])
  @@index([costDate])
  @@map("order_costs")
}

enum ExpenseCategory {
  RENT
  ELECTRICITY
  WATER
  INTERNET
  MAINTENANCE
  TRANSPORT
  CLEANING
  SUPPLIES
  ADMINISTRATIVE
  OTHER
}

/// A general business expense, NOT tied to any order (rent, electricity…).
/// Kept separate so future overhead allocation can reference these rows
/// without copying (and double counting) them.
model GeneralExpense {
  id             String          @id @default(uuid(7)) @db.Uuid
  category       ExpenseCategory
  description    String?         @db.VarChar(300)
  amount         Decimal         @db.Decimal(12, 2)
  expenseDate    DateTime        @map("expense_date") @db.Date
  idempotencyKey String          @unique @map("idempotency_key") @db.Uuid
  recordedById   String          @map("recorded_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt       DateTime?       @map("voided_at") @db.Timestamptz(3)
  voidedById     String?         @map("voided_by_id") @db.Uuid
  voidReason     String?         @map("void_reason") @db.VarChar(300)

  recordedBy User              @relation("ExpenseRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy   User?             @relation("ExpenseVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  payments   OutgoingPayment[]

  @@index([expenseDate])
  @@index([category, expenseDate])
  @@map("general_expenses")
}

/// Cash paid out, against exactly ONE order cost, ONE general expense or ONE worker.
model OutgoingPayment {
  id             String        @id @default(uuid(7)) @db.Uuid
  orderCostId    String?       @map("order_cost_id") @db.Uuid
  expenseId      String?       @map("expense_id") @db.Uuid
  /// Worker payments (wages / advances). Set together with workerPaymentType.
  workerId          String?            @map("worker_id") @db.Uuid
  workerPaymentType WorkerPaymentType? @map("worker_payment_type")
  amount         Decimal       @db.Decimal(12, 2)
  paidAt         DateTime      @map("paid_at") @db.Date
  method         PaymentMethod
  notes          String?       @db.VarChar(500)
  idempotencyKey String        @unique @map("idempotency_key") @db.Uuid
  recordedById   String        @map("recorded_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt       DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedById     String?       @map("voided_by_id") @db.Uuid
  voidReason     String?       @map("void_reason") @db.VarChar(300)

  orderCost  OrderCost?      @relation(fields: [orderCostId], references: [id], onDelete: Restrict)
  expense    GeneralExpense? @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  worker     Worker?         @relation(fields: [workerId], references: [id], onDelete: Restrict)
  recordedBy User            @relation("OutgoingPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy   User?           @relation("OutgoingPaymentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([orderCostId])
  @@index([expenseId])
  @@index([workerId, paidAt])
  @@index([paidAt])
  @@map("outgoing_payments")
}

// ───────────────────────────── Phase 4: workers, daily wages & productivity ─────────────────────────────
//
//  • WorkerWorkday — the authoritative LABOUR COST: one valid row per worker per
//    date, with the day's wage snapshotted (later wage changes never touch it).
//  • WorkerWorkLog — what the worker produced (productivity + how the day's wage
//    is split across orders). NOT official order production (Phase 5).
//  • Wage payments / advances — OutgoingPayment rows with workerId (cash only).
//  • Allocation of wages to orders is DERIVED from workdays + logs, never stored,
//    so labour is counted exactly once.

enum WorkerJob {
  DTF_PRINTING
  EMBROIDERY
  SCREEN_PRINTING
  GARMENT_MAKING
  FINISHING_PACKING
  OTHER
}

enum WorkUnit {
  PIECE
  PRINT
  METER
  PRESS
  COVER
}

enum WorkType {
  DTF
  SCREEN_PRINT
  EMBROIDERY
  CUTTING
  SEWING
  FINISHING
  PACKING
  OTHER
}

enum WorkerPaymentType {
  WAGE
  ADVANCE
}

/// A shop worker. Not an app user: no login needed.
model Worker {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @db.VarChar(120)
  phone       String?   @db.VarChar(30)
  job         WorkerJob
  /// Optional custom wording for the job (e.g. "مكوجي").
  jobTitle    String?   @map("job_title") @db.VarChar(80)
  /// Current standard daily wage. Workdays keep their own snapshot.
  dailyWage   Decimal   @map("daily_wage") @db.Decimal(12, 2)
  dailyTarget Int?      @map("daily_target")
  targetUnit  WorkUnit? @map("target_unit")
  isActive    Boolean   @default(true) @map("is_active")
  notes       String?   @db.VarChar(1000)
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User              @relation("WorkerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  workdays  WorkerWorkday[]
  workLogs  WorkerWorkLog[]
  payments  OutgoingPayment[]

  @@index([isActive, name])
  @@map("workers")
}

/// One day of a worker. worked=true earns `wage` (snapshot); worked=false
/// records an absence (wage 0). Max one non-voided row per worker+date.
model WorkerWorkday {
  id             String    @id @default(uuid(7)) @db.Uuid
  workerId       String    @map("worker_id") @db.Uuid
  workDate       DateTime  @map("work_date") @db.Date
  worked         Boolean   @default(true)
  wage           Decimal   @db.Decimal(12, 2)
  notes          String?   @db.VarChar(500)
  idempotencyKey String    @unique @map("idempotency_key") @db.Uuid
  recordedById   String    @map("recorded_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedById     String?   @map("voided_by_id") @db.Uuid
  voidReason     String?   @map("void_reason") @db.VarChar(300)

  worker     Worker          @relation(fields: [workerId], references: [id], onDelete: Restrict)
  recordedBy User            @relation("WorkdayRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy   User?           @relation("WorkdayVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  workLogs   WorkerWorkLog[]

  @@index([workerId, workDate])
  @@index([workDate])
  @@map("worker_workdays")
}

/// What a worker produced on a workday, optionally for an order (and group).
model WorkerWorkLog {
  id             String    @id @default(uuid(7)) @db.Uuid
  workdayId      String    @map("workday_id") @db.Uuid
  workerId       String    @map("worker_id") @db.Uuid
  orderId        String?   @map("order_id") @db.Uuid
  orderGroupId   String?   @map("order_group_id") @db.Uuid
  workType       WorkType  @map("work_type")
  quantity       Int
  unit           WorkUnit
  /// Hours spent — the split basis when one day mixes different units.
  hours          Decimal?  @db.Decimal(5, 2)
  notes          String?   @db.VarChar(500)
  idempotencyKey String    @unique @map("idempotency_key") @db.Uuid
  recordedById   String    @map("recorded_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedById     String?   @map("voided_by_id") @db.Uuid
  voidReason     String?   @map("void_reason") @db.VarChar(300)

  workday    WorkerWorkday @relation(fields: [workdayId], references: [id], onDelete: Restrict)
  worker     Worker        @relation(fields: [workerId], references: [id], onDelete: Restrict)
  order      Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// RESTRICT: a group with work logged against it can never be deleted.
  orderGroup OrderGroup?   @relation(fields: [orderGroupId], references: [id], onDelete: Restrict)
  recordedBy User          @relation("WorkLogRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy   User?         @relation("WorkLogVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  /// Physical pieces this work completed for a stage, when confirmed in the same submission.
  stageProgress ProductionStageProgress?

  @@index([workdayId])
  @@index([orderId])
  @@index([orderGroupId])
  @@index([workerId, createdAt])
  @@map("worker_work_logs")
}

// ───────────────────────────── Phase 5: production & partial delivery ─────────────────────────────
//
// Physical units of an order group (the order's own unit), never worker
// "prints": three kinds of records, all whole numbers, all voidable (never deleted):
//   • ProductionStageProgress — N pieces finished ONE required operation (DTF, …).
//   • ProductionReady         — N pieces confirmed finished with ALL operations
//                               (the authoritative "finished" quantity).
//   • Delivery                — N ready pieces handed to the customer.
// Per group: stage_total(op) ≤ quantity; ready ≤ min(stage totals) and ≤ quantity;
// delivered ≤ ready. Every write locks the order row, so these hold under concurrency.

model ProductionStageProgress {
  id             String         @id @default(uuid(7)) @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  /// Set for groups with a size breakdown (then every record names its size).
  orderGroupSizeId String?     @map("order_group_size_id") @db.Uuid
  orderGroupId   String         @map("order_group_id") @db.Uuid
  operation      PrintOperation
  quantity       Int
  workDate       DateTime       @map("work_date") @db.Date
  notes          String?        @db.VarChar(500)
  /// Set when confirmed together with a worker's output record (traceability only).
  workLogId      String?        @unique @map("work_log_id") @db.Uuid
  idempotencyKey String         @unique @map("idempotency_key") @db.Uuid
  recordedById   String         @map("recorded_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt       DateTime?      @map("voided_at") @db.Timestamptz(3)
  voidedById     String?        @map("voided_by_id") @db.Uuid
  voidReason     String?        @map("void_reason") @db.VarChar(300)

  order      Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderGroup OrderGroup          @relation(fields: [orderGroupId], references: [id], onDelete: Restrict)
  orderGroupSize OrderGroupSize? @relation(fields: [orderGroupSizeId], references: [id], onDelete: Restrict)
  /// The operation must be one the group actually requires.
  requiredOperation OrderGroupOperation @relation(fields: [orderGroupId, operation], references: [groupId, operation], onDelete: Restrict)
  workLog    WorkerWorkLog?      @relation(fields: [workLogId], references: [id], onDelete: Restrict)
  recordedBy User                @relation("StageRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy   User?               @relation("StageVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([orderGroupSizeId])
  @@index([orderGroupId, operation])
  @@index([workDate])
  @@map("production_stage_progress")
}

model ProductionReady {
  id             String    @id @default(uuid(7)) @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  /// Set for groups with a size breakdown (then every record names its size).
  orderGroupSizeId String?     @map("order_group_size_id") @db.Uuid
  orderGroupId   String    @map("order_group_id") @db.Uuid
  quantity       Int
  readyDate      DateTime  @map("ready_date") @db.Date
  notes          String?   @db.VarChar(500)
  /// The stage record saved in the same submission (single-operation groups).
  stageProgressId String?  @unique @map("stage_progress_id") @db.Uuid
  idempotencyKey String    @unique @map("idempotency_key") @db.Uuid
  recordedById   String    @map("recorded_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedById     String?   @map("voided_by_id") @db.Uuid
  voidReason     String?   @map("void_reason") @db.VarChar(300)

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderGroup OrderGroup @relation(fields: [orderGroupId], references: [id], onDelete: Restrict)
  orderGroupSize OrderGroupSize? @relation(fields: [orderGroupSizeId], references: [id], onDelete: Restrict)
  recordedBy User       @relation("ReadyRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy   User?      @relation("ReadyVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([orderGroupSizeId])
  @@index([orderGroupId])
  @@map("production_ready")
}

model Delivery {
  id             String    @id @default(uuid(7)) @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  /// Set for groups with a size breakdown (then every record names its size).
  orderGroupSizeId String?     @map("order_group_size_id") @db.Uuid
  orderGroupId   String    @map("order_group_id") @db.Uuid
  quantity       Int
  deliveredAt    DateTime  @map("delivered_at") @db.Date
  notes          String?   @db.VarChar(500)
  idempotencyKey String    @unique @map("idempotency_key") @db.Uuid
  recordedById   String    @map("recorded_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedById     String?   @map("voided_by_id") @db.Uuid
  voidReason     String?   @map("void_reason") @db.VarChar(300)

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderGroup OrderGroup @relation(fields: [orderGroupId], references: [id], onDelete: Restrict)
  orderGroupSize OrderGroupSize? @relation(fields: [orderGroupSizeId], references: [id], onDelete: Restrict)
  recordedBy User       @relation("DeliveryRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy   User?      @relation("DeliveryVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([orderGroupSizeId])
  @@index([orderGroupId])
  @@index([deliveredAt])
  @@map("deliveries")
}

// ───────────────────────────── Garment sizes ─────────────────────────────
//
// A lightweight size breakdown per work group (e.g. S 50 · M 50 · L 50 · XL 50).
// Not a variant/SKU system: just labels and quantities that add up to the
// group's quantity. Production, ready and delivery records of a sized group
// each name their size, so every per-size balance is computed from events.
// Unsized groups (and all records created before sizes existed) keep working.

model OrderGroupSize {
  id           String   @id @default(uuid(7)) @db.Uuid
  orderGroupId String   @map("order_group_id") @db.Uuid
  /// Normalized label: "S", "2XL", "38", "10 سنين" (see src/lib/orders/sizes.ts).
  label        String   @db.VarChar(24)
  position     Int
  quantity     Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orderGroup    OrderGroup                @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)
  stageProgress ProductionStageProgress[]
  ready         ProductionReady[]
  deliveries    Delivery[]

  @@unique([orderGroupId, label])
  @@index([orderGroupId, position])
  @@map("order_group_sizes")
}
