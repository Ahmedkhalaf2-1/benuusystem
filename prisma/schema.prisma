// Benuuprint ERP — database schema.
// Table and column names are snake_case in PostgreSQL; models are PascalCase in code.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Coarse roles. OWNER_ADMIN has every permission. STAFF has exactly the
/// permissions in `User.permissions` (deny by default) — see
/// src/lib/auth/permissions.ts. PARTNER = an external party (e.g. an
/// embroidery workshop): no company-wide permission ever applies; it reaches
/// only the department items it is a member of (`DepartmentMember`).
enum Role {
  OWNER_ADMIN
  STAFF
  PARTNER
}

model User {
  id                 String   @id @default(uuid(7)) @db.Uuid
  name               String   @db.VarChar(100)
  /// Always stored lowercase and trimmed.
  email              String   @unique @db.VarChar(254)
  passwordHash       String   @map("password_hash")
  role               Role     @default(STAFF)
  isActive           Boolean  @default(true) @map("is_active")
  /// STAFF only: individually granted permission keys (deny by default).
  /// Ignored for OWNER_ADMIN, who always has every permission. Unknown or
  /// owner-only keys are ignored when evaluating.
  permissions        String[] @default([])
  /// Bumped on every permission/activation change (optimistic concurrency).
  permissionsVersion Int      @default(0) @map("permissions_version")
  /// PARTNER only: the supplier record that holds what Benuuprint owes this
  /// partner (order costs + outgoing payments). One partner ↔ one supplier.
  supplierId         String?  @unique @map("supplier_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions  Session[]
  auditLogs AuditLog[]

  customersCreated Customer[]     @relation("CustomerCreatedBy")
  ordersCreated    Order[]        @relation("OrderCreatedBy")
  ordersArchived   Order[]        @relation("OrderArchivedBy")
  paymentsRecorded OrderPayment[] @relation("PaymentRecordedBy")
  paymentsVoided   OrderPayment[] @relation("PaymentVoidedBy")

  suppliersCreated         Supplier[]        @relation("SupplierCreatedBy")
  orderCostsRecorded       OrderCost[]       @relation("OrderCostRecordedBy")
  orderCostsVoided         OrderCost[]       @relation("OrderCostVoidedBy")
  expensesRecorded         GeneralExpense[]  @relation("ExpenseRecordedBy")
  expensesVoided           GeneralExpense[]  @relation("ExpenseVoidedBy")
  outgoingPaymentsRecorded OutgoingPayment[] @relation("OutgoingPaymentRecordedBy")
  outgoingPaymentsVoided   OutgoingPayment[] @relation("OutgoingPaymentVoidedBy")

  workersCreated   Worker[]        @relation("WorkerCreatedBy")
  workdaysRecorded WorkerWorkday[] @relation("WorkdayRecordedBy")
  workdaysVoided   WorkerWorkday[] @relation("WorkdayVoidedBy")
  workLogsRecorded WorkerWorkLog[] @relation("WorkLogRecordedBy")
  workLogsVoided   WorkerWorkLog[] @relation("WorkLogVoidedBy")

  stageProgressRecorded ProductionStageProgress[] @relation("StageRecordedBy")
  stageProgressVoided   ProductionStageProgress[] @relation("StageVoidedBy")
  readyRecorded         ProductionReady[]         @relation("ReadyRecordedBy")
  readyVoided           ProductionReady[]         @relation("ReadyVoidedBy")
  deliveriesRecorded    Delivery[]                @relation("DeliveryRecordedBy")
  deliveriesVoided      Delivery[]                @relation("DeliveryVoidedBy")

  financialAccountsCreated  FinancialAccount[]       @relation("FinancialAccountCreatedBy")
  treasuryMovementsRecorded TreasuryMovement[]       @relation("TreasuryMovementRecordedBy")
  treasuryMovementsVoided   TreasuryMovement[]       @relation("TreasuryMovementVoidedBy")
  reconciliationsRecorded   TreasuryReconciliation[] @relation("ReconciliationRecordedBy")
  orderAccess               OrderAccess[]            @relation("OrderAccessUser")
  orderAccessGranted        OrderAccess[]            @relation("OrderAccessGrantedBy")
  departmentMemberships     DepartmentMember[]       @relation("DepartmentMemberUser")
  departmentGrants          DepartmentMember[]       @relation("DepartmentMemberGrantedBy")
  departmentsCreated        Department[]             @relation("DepartmentCreatedBy")
  partnerSupplier           Supplier?                @relation("PartnerSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
  valueSharesSet            OrderGroupValueShare[]   @relation("ValueShareSetBy")
  costRevisions             OrderCostRevision[]      @relation("CostRevisionBy")
  workKindSettings          WorkKindSetting[]        @relation("WorkKindSettingBy")
  presetsCreated            ProductPreset[]          @relation("PresetCreatedBy")
  recurringExpenses         RecurringExpense[]       @relation("RecurringExpenseCreatedBy")
  monthlyClosesConfirmed    MonthlyClose[]           @relation("MonthlyCloseConfirmedBy")
  monthlyCloseEvents        MonthlyCloseEvent[]      @relation("MonthlyCloseEventBy")

  @@map("users")
}

/// Server-side sessions. The cookie holds a random token; only its SHA-256
/// hash is stored, so a database leak does not expose usable sessions.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Append-only record of sensitive actions.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Null for actions without a known user (e.g. failed login for an unknown email).
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(64)
  entityType String?  @map("entity_type") @db.VarChar(64)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Failed login attempts, used for rate limiting. Stored in the database so
/// limits hold across restarts and multiple app processes. Old rows are pruned.
model LoginAttempt {
  id        String   @id @default(uuid(7)) @db.Uuid
  email     String   @db.VarChar(254)
  ipAddress String   @map("ip_address") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

// ───────────────────────────── Phase 2: customers & orders ─────────────────────────────

/// Simple named counters (e.g. order numbers). Incremented with
/// UPDATE … RETURNING inside the same transaction as the insert, which makes
/// numbers gapless and safe under concurrency (the row lock serializes writers).
model Counter {
  key   String @id @db.VarChar(64)
  value Int    @default(0)

  @@map("counters")
}

model Customer {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @db.VarChar(120)
  /// As typed (Arabic digits converted to 0-9). Optional, not unique.
  phone       String?  @db.VarChar(30)
  notes       String?  @db.VarChar(1000)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User    @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  orders    Order[]

  @@index([name])
  @@index([phone])
  @@index([createdAt])
  @@map("customers")
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  /// Reserved for the delivery phase; not settable from the UI yet.
  COMPLETED
  CANCELLED
}

enum QuantityUnit {
  PIECE
  SET
  DOZEN
  METER
}

enum PrintOperation {
  DTF
  SCREEN_PRINT
  EMBROIDERY
  /// Garment making (optional required step for garment orders). Phase 5.
  MANUFACTURING
  /// «طباعة للغير» methods without an older operation (production steps like any other).
  VINYL
  SUBLIMATION
  OTHER_PRINT
}

enum OrderPricing {
  ORDER_TOTAL
  PER_ITEM
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  INSTAPAY
  OTHER
}

/// Who besides the owner may see an order («ظهور الأوردر للعمال»).
enum OrderVisibility {
  /// «خاص بالمدير فقط»
  PRIVATE
  /// «ظاهر لكل العاملين المصرح لهم» — every active staff with orders:view.
  ALL_AUTHORIZED_STAFF
  /// «عمال محددون فقط» — staff listed in order_access.
  SELECTED_STAFF
}

model Order {
  id                    String            @id @default(uuid(7)) @db.Uuid
  /// Human order number (#0001), gapless, from the "order_number" counter.
  number                Int               @unique
  customerId            String            @map("customer_id") @db.Uuid
  title                 String            @db.VarChar(150)
  productType           String            @map("product_type") @db.VarChar(80)
  material              String            @db.VarChar(80)
  quantity              Int
  unit                  QuantityUnit      @default(PIECE)
  /// Agreed selling price for the whole order. Outstanding is always derived
  /// (totalPrice − sum of valid payments) and never stored.
  totalPrice            Decimal           @map("total_price") @db.Decimal(12, 2)
  receivedDate          DateTime          @map("received_date") @db.Date
  deliveryDate          DateTime          @map("delivery_date") @db.Date
  notes                 String?           @db.VarChar(2000)
  status                OrderStatus       @default(NEW)
  /// When the last piece was delivered (set/cleared by production automation).
  completedAt           DateTime?         @map("completed_at") @db.Timestamptz(3)
  /// ORDER_TOTAL: one agreed price for the whole order (all orders before
  /// line-item pricing). PER_ITEM: totalPrice = Σ group quantity × unitPrice,
  /// computed by the server.
  pricing               OrderPricing      @default(ORDER_TOTAL)
  /// Owner removed an untouched order from active views (never deleted).
  archivedAt            DateTime?         @map("archived_at") @db.Timestamptz(3)
  archivedById          String?           @map("archived_by_id") @db.Uuid
  archiveReason         String?           @map("archive_reason") @db.VarChar(300)
  /// Client-generated key: a retried/double-clicked submit returns the same order.
  idempotencyKey        String?           @unique @map("idempotency_key") @db.Uuid
  /// Staff visibility. Owners always see every order.
  visibility            OrderVisibility   @default(PRIVATE)
  /// Bumped on every visibility/assignment change (optimistic concurrency).
  accessVersion         Int               @default(0) @map("access_version")
  /// Owner: keep this order out of every department view for non-owners
  /// (partners and department members) — work, values and collections.
  hiddenFromDepartments Boolean           @default(false) @map("hidden_from_departments")
  /// Cost review («التكاليف»): new orders start PENDING (set by the app); null = created before cost tracking.
  costStatus            CostReviewStatus? @map("cost_status")
  costReviewedAt        DateTime?         @map("cost_reviewed_at") @db.Timestamptz(3)
  costReviewedById      String?           @map("cost_reviewed_by_id") @db.Uuid
  /// Bumped on every close / reopen / status change (optimistic concurrency).
  costVersion           Int               @default(0) @map("cost_version")
  createdById           String            @map("created_by_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer      Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy     User                      @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  archivedBy    User?                     @relation("OrderArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  groups        OrderGroup[]
  payments      OrderPayment[]
  costs         OrderCost[]
  workLogs      WorkerWorkLog[]
  stageProgress ProductionStageProgress[]
  ready         ProductionReady[]
  deliveries    Delivery[]
  access        OrderAccess[]

  @@index([customerId])
  @@index([status, deliveryDate])
  @@index([createdAt])
  @@index([deliveryDate])
  @@index([archivedAt])
  @@map("orders")
}

/// A slice of an order with the same work (e.g. "50 pieces: DTF + embroidery").
/// Quantities of all groups add up to the order quantity.
model OrderGroup {
  id               String             @id @default(uuid(7)) @db.Uuid
  orderId          String             @map("order_id") @db.Uuid
  position         Int
  quantity         Int
  material         String             @db.VarChar(80)
  notes            String?            @db.VarChar(500)
  /// «اسم البند / الرسمة». Null on orders created before named items.
  name             String?            @db.VarChar(120)
  /// Selling price per unit (PER_ITEM orders). Never back-filled for old orders.
  unitPrice        Decimal?           @map("unit_price") @db.Decimal(12, 2)
  /// Planned press operations per piece for items WITHOUT designs (capacity
  /// planning only; items with designs plan presses per design).
  pressesPerUnit   Int?               @map("presses_per_unit")
  /// Designs / print placements on this item's pieces (empty for older items,
  /// which keep their item-level operations).
  designs          OrderGroupDesign[]
  /// The ONE department that does this item («القسم»). An item's value
  /// (quantity × unitPrice) belongs to its department only — never split or
  /// counted twice. Set on every new/edited item; null only if no department
  /// existed (shown as «غير محدد»).
  departmentId     String?            @map("department_id") @db.Uuid
  /// «نوع الشغل» (src/lib/orders/work-kinds.ts): DTF_PAPER, VINYL_PAPER… Null = garment / ready-made item (as before).
  workKind         String?            @map("work_kind") @db.VarChar(40)
  /// The material / method of this line (WHITE_80, BLACK, SUBLIMATION, POLYESTER, OTHER…).
  variant          String?            @db.VarChar(40)
  /// Typed text when the variant is «أخرى», or a raw material's name.
  variantText      String?            @map("variant_text") @db.VarChar(120)
  threadColor      String?            @map("thread_color") @db.VarChar(60)
  /// Raw materials: the unit sold (PIECE, KG, ROLL…).
  saleUnit         String?            @map("sale_unit") @db.VarChar(20)
  /// UNIT: quantity × unitPrice. LINEAR_METER: billableLengthMm × unitPrice (per linear meter) / 1000.
  pricingBasis     ItemPricingBasis   @default(UNIT) @map("pricing_basis")
  fileWidthMm      Int?               @map("file_width_mm")
  fileLengthMm     Int?               @map("file_length_mm")
  copiesPerRow     Int?               @map("copies_per_row")
  rollWidthMm      Int?               @map("roll_width_mm")
  /// Billed (quoted) length — never the consumed length (that is a cost entry).
  billableLengthMm Int?               @map("billable_length_mm")
  /// MEASURED items: the sold quantity with up to 3 decimals (e.g. 2.75 kg). `quantity` is then 1 (one lot to deliver).
  measuredQuantity Decimal?           @map("measured_quantity") @db.Decimal(14, 3)

  order         Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  department    Department?               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  costs         OrderCost[]
  /// Owner's explicit split of THIS item's value across departments (work
  /// shared between departments). Empty = the whole value is its department's.
  valueShares   OrderGroupValueShare[]
  operations    OrderGroupOperation[]
  /// Optional garment-size breakdown; when present, sizes add up to `quantity`.
  sizes         OrderGroupSize[]
  workLogs      WorkerWorkLog[]
  stageProgress ProductionStageProgress[]
  ready         ProductionReady[]
  deliveries    Delivery[]

  @@unique([orderId, position])
  @@index([departmentId])
  @@map("order_groups")
}

/// A business line («تطريز»، «كوفرات»، «طباعة»، «ملابس / منتج كامل»). A
/// table, not an enum: the owner adds departments without a code change.
/// Never deleted (items point at it); deactivated instead.
model Department {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Stable code of a seeded department (used only to suggest a department
  /// from the work type). Null for departments the owner adds.
  key         String?  @unique @db.VarChar(40)
  name        String   @unique @db.VarChar(80)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   User?                  @relation("DepartmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items       OrderGroup[]
  members     DepartmentMember[]
  valueShares OrderGroupValueShare[]
  costs       OrderCost[]

  @@map("departments")
}

/// Which non-owner account may reach which department, and how far. Read from
/// the database on every request, so a revocation applies immediately.
model DepartmentMember {
  departmentId        String   @map("department_id") @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  /// See the department's items, production and dashboard.
  canViewWork         Boolean  @default(true) @map("can_view_work")
  /// See the value of the department's items (never customer payments).
  canViewMoney        Boolean  @default(false) @map("can_view_money")
  /// Record production steps / «جاهز» on the department's items.
  canRecordProduction Boolean  @default(false) @map("can_record_production")
  /// See customer collections ALLOCATED to the department (derived, pro-rata).
  canViewCollections  Boolean  @default(false) @map("can_view_collections")
  /// PARTNER: see their own settlement (jobs owed by Benuuprint, paid, balance) for this department.
  canViewSettlements  Boolean  @default(false) @map("can_view_settlements")
  grantedById         String   @map("granted_by_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation("DepartmentMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy  User       @relation("DepartmentMemberGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)

  @@id([departmentId, userId])
  @@index([userId])
  @@map("department_members")
}

/// Zero rows for a group = plain (no printing or embroidery).
model OrderGroupOperation {
  groupId   String         @map("group_id") @db.Uuid
  operation PrintOperation

  group         OrderGroup                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// RESTRICT: a required operation with recorded progress can't be removed.
  stageProgress ProductionStageProgress[]

  @@id([groupId, operation])
  @@map("order_group_operations")
}

/// Customer payments. Never deleted or edited: corrections are made by voiding
/// (owner only, with a reason) so the full history stays visible.
model OrderPayment {
  id             String        @id @default(uuid(7)) @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  paidAt         DateTime      @map("paid_at") @db.Date
  method         PaymentMethod
  notes          String?       @db.VarChar(500)
  /// True for the advance recorded together with the new order.
  isAdvance      Boolean       @default(false) @map("is_advance")
  idempotencyKey String        @unique @map("idempotency_key") @db.Uuid
  recordedById   String        @map("recorded_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt       DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedById     String?       @map("voided_by_id") @db.Uuid
  voidReason     String?       @map("void_reason") @db.VarChar(300)
  /// Treasury account the money actually went into. Null = not attributed
  /// (every payment recorded before the treasury existed).
  accountId      String?       @map("account_id") @db.Uuid

  order      Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  recordedBy User              @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy   User?             @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  account    FinancialAccount? @relation("OrderPaymentAccount", fields: [accountId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([paidAt])
  @@index([accountId, paidAt])
  @@map("order_payments")
}

// ───────────────────────────── Phase 3: costs, suppliers & expenses ─────────────────────────────
//
// Three distinct things, never mixed:
//   • OrderCost / GeneralExpense — what something COST (counted once, when recorded,
//     whether paid or not).
//   • OutgoingPayment — CASH that actually left the business, always against exactly
//     one cost or one expense (so a supplier payment can never be counted as a new cost).
//   • Balances (supplier owed, unpaid) — always computed: cost − valid payments.
// Nothing is deleted or edited: corrections are owner-only voids with a reason.

model Supplier {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @db.VarChar(120)
  phone       String?  @db.VarChar(30)
  notes       String?  @db.VarChar(1000)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User        @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  costs     OrderCost[]
  /// The partner account settled through this supplier record, if any.
  partner   User?       @relation("PartnerSupplier")

  @@index([name])
  @@index([phone])
  @@map("suppliers")
}

enum CostCategory {
  MATERIALS
  PRINTING
  EMBROIDERY
  OUTSOURCED_LABOR
  TRANSPORT
  PACKAGING
  OTHER
}

/// A direct cost of one order (fabric, printing, outside workshop…).
model OrderCost {
  id              String       @id @default(uuid(7)) @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  category        CostCategory
  description     String?      @db.VarChar(200)
  /// Full cost, counted when recorded — paid or not.
  amount          Decimal      @db.Decimal(12, 2)
  costDate        DateTime     @map("cost_date") @db.Date
  supplierId      String?      @map("supplier_id") @db.Uuid
  /// The department the work belongs to (partner settlements). Optional.
  departmentId    String?      @map("department_id") @db.Uuid
  /// «بالقطعة»: pieces × agreed cost per piece = amount (both or neither).
  quantity        Int?
  unitCost        Decimal?     @map("unit_cost") @db.Decimal(12, 2)
  /// Draft entry from «التكاليف»: NOT a payable until the order's costs are closed (then posted).
  isDraft         Boolean      @default(false) @map("is_draft")
  postedAt        DateTime?    @map("posted_at") @db.Timestamptz(3)
  /// The order item / work line this cost belongs to (optional).
  orderGroupId    String?      @map("order_group_id") @db.Uuid
  /// Material consumption: what was used, how much, in which unit, at what unit cost.
  materialName    String?      @map("material_name") @db.VarChar(120)
  materialVariant String?      @map("material_variant") @db.VarChar(80)
  usageQuantity   Decimal?     @map("usage_quantity") @db.Decimal(14, 3)
  usageUnit       String?      @map("usage_unit") @db.VarChar(20)
  usageUnitCost   Decimal?     @map("usage_unit_cost") @db.Decimal(12, 2)
  /// Bumped on every amendment (optimistic concurrency).
  version         Int          @default(0)
  notes           String?      @db.VarChar(500)
  idempotencyKey  String       @unique @map("idempotency_key") @db.Uuid
  recordedById    String       @map("recorded_by_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt        DateTime?    @map("voided_at") @db.Timestamptz(3)
  voidedById      String?      @map("voided_by_id") @db.Uuid
  voidReason      String?      @map("void_reason") @db.VarChar(300)

  order      Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  supplier   Supplier?           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  department Department?         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  orderGroup OrderGroup?         @relation(fields: [orderGroupId], references: [id], onDelete: Restrict)
  revisions  OrderCostRevision[]
  recordedBy User                @relation("OrderCostRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy   User?               @relation("OrderCostVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  payments   OutgoingPayment[]

  @@index([orderId])
  @@index([supplierId])
  @@index([departmentId])
  @@index([costDate])
  @@index([orderGroupId])
  @@index([materialName, costDate])
  @@map("order_costs")
}

enum ExpenseCategory {
  RENT
  ELECTRICITY
  WATER
  INTERNET
  MAINTENANCE
  TRANSPORT
  CLEANING
  SUPPLIES
  ADMINISTRATIVE
  /// Salaries of staff who are NOT daily-wage workers (worker wages come from the workers system).
  SALARIES
  OTHER
}

/// A general business expense, NOT tied to any order (rent, electricity…).
/// Kept separate so future overhead allocation can reference these rows
/// without copying (and double counting) them.
model GeneralExpense {
  id             String          @id @default(uuid(7)) @db.Uuid
  category       ExpenseCategory
  description    String?         @db.VarChar(300)
  amount         Decimal         @db.Decimal(12, 2)
  expenseDate    DateTime        @map("expense_date") @db.Date
  /// Fixed (recurring) cost of running the business, e.g. rent — shown apart from other operating expenses.
  isFixed        Boolean         @default(false) @map("is_fixed")
  /// Created from a recurring template for one month (YYYY-MM): at most one per template per month.
  recurringId    String?         @map("recurring_id") @db.Uuid
  recurringMonth String?         @map("recurring_month") @db.Char(7)
  idempotencyKey String          @unique @map("idempotency_key") @db.Uuid
  recordedById   String          @map("recorded_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt       DateTime?       @map("voided_at") @db.Timestamptz(3)
  voidedById     String?         @map("voided_by_id") @db.Uuid
  voidReason     String?         @map("void_reason") @db.VarChar(300)

  recordedBy User              @relation("ExpenseRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy   User?             @relation("ExpenseVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  recurring  RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: Restrict)
  payments   OutgoingPayment[]

  @@unique([recurringId, recurringMonth])
  @@index([expenseDate])
  @@index([category, expenseDate])
  @@map("general_expenses")
}

/// Cash paid out, against exactly ONE order cost, ONE general expense or ONE worker.
model OutgoingPayment {
  id                String             @id @default(uuid(7)) @db.Uuid
  orderCostId       String?            @map("order_cost_id") @db.Uuid
  expenseId         String?            @map("expense_id") @db.Uuid
  /// Worker payments (wages / advances). Set together with workerPaymentType.
  workerId          String?            @map("worker_id") @db.Uuid
  workerPaymentType WorkerPaymentType? @map("worker_payment_type")
  amount            Decimal            @db.Decimal(12, 2)
  paidAt            DateTime           @map("paid_at") @db.Date
  method            PaymentMethod
  notes             String?            @db.VarChar(500)
  idempotencyKey    String             @unique @map("idempotency_key") @db.Uuid
  recordedById      String             @map("recorded_by_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt          DateTime?          @map("voided_at") @db.Timestamptz(3)
  voidedById        String?            @map("voided_by_id") @db.Uuid
  voidReason        String?            @map("void_reason") @db.VarChar(300)
  /// Treasury account the money actually left. Null = not attributed.
  accountId         String?            @map("account_id") @db.Uuid

  account    FinancialAccount? @relation("OutgoingPaymentAccount", fields: [accountId], references: [id], onDelete: Restrict)
  orderCost  OrderCost?        @relation(fields: [orderCostId], references: [id], onDelete: Restrict)
  expense    GeneralExpense?   @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  worker     Worker?           @relation(fields: [workerId], references: [id], onDelete: Restrict)
  recordedBy User              @relation("OutgoingPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy   User?             @relation("OutgoingPaymentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([orderCostId])
  @@index([expenseId])
  @@index([workerId, paidAt])
  @@index([paidAt])
  @@index([accountId, paidAt])
  @@map("outgoing_payments")
}

// ───────────────────────────── Phase 4: workers, daily wages & productivity ─────────────────────────────
//
//  • WorkerWorkday — the authoritative LABOUR COST: one valid row per worker per
//    date, with the day's wage snapshotted (later wage changes never touch it).
//  • WorkerWorkLog — what the worker produced (productivity + how the day's wage
//    is split across orders). NOT official order production (Phase 5).
//  • Wage payments / advances — OutgoingPayment rows with workerId (cash only).
//  • Allocation of wages to orders is DERIVED from workdays + logs, never stored,
//    so labour is counted exactly once.

enum WorkerJob {
  DTF_PRINTING
  EMBROIDERY
  SCREEN_PRINTING
  GARMENT_MAKING
  FINISHING_PACKING
  OTHER
}

enum WorkUnit {
  PIECE
  PRINT
  METER
  PRESS
  COVER
}

enum WorkType {
  DTF
  SCREEN_PRINT
  EMBROIDERY
  CUTTING
  SEWING
  FINISHING
  PACKING
  OTHER
}

enum WorkerPaymentType {
  WAGE
  ADVANCE
}

/// A shop worker. Not an app user: no login needed.
model Worker {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @db.VarChar(120)
  phone       String?   @db.VarChar(30)
  job         WorkerJob
  /// Optional custom wording for the job (e.g. "مكوجي").
  jobTitle    String?   @map("job_title") @db.VarChar(80)
  /// Current standard daily wage. Workdays keep their own snapshot.
  dailyWage   Decimal   @map("daily_wage") @db.Decimal(12, 2)
  dailyTarget Int?      @map("daily_target")
  targetUnit  WorkUnit? @map("target_unit")
  isActive    Boolean   @default(true) @map("is_active")
  notes       String?   @db.VarChar(1000)
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User              @relation("WorkerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  workdays  WorkerWorkday[]
  workLogs  WorkerWorkLog[]
  payments  OutgoingPayment[]

  @@index([isActive, name])
  @@map("workers")
}

/// One day of a worker. worked=true earns `wage` (snapshot); worked=false
/// records an absence (wage 0). Max one non-voided row per worker+date.
model WorkerWorkday {
  id             String    @id @default(uuid(7)) @db.Uuid
  workerId       String    @map("worker_id") @db.Uuid
  workDate       DateTime  @map("work_date") @db.Date
  worked         Boolean   @default(true)
  wage           Decimal   @db.Decimal(12, 2)
  notes          String?   @db.VarChar(500)
  idempotencyKey String    @unique @map("idempotency_key") @db.Uuid
  recordedById   String    @map("recorded_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedById     String?   @map("voided_by_id") @db.Uuid
  voidReason     String?   @map("void_reason") @db.VarChar(300)

  worker     Worker          @relation(fields: [workerId], references: [id], onDelete: Restrict)
  recordedBy User            @relation("WorkdayRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy   User?           @relation("WorkdayVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  workLogs   WorkerWorkLog[]

  @@index([workerId, workDate])
  @@index([workDate])
  @@map("worker_workdays")
}

/// What a worker produced on a workday, optionally for an order (and group).
model WorkerWorkLog {
  id             String    @id @default(uuid(7)) @db.Uuid
  workdayId      String    @map("workday_id") @db.Uuid
  workerId       String    @map("worker_id") @db.Uuid
  orderId        String?   @map("order_id") @db.Uuid
  orderGroupId   String?   @map("order_group_id") @db.Uuid
  workType       WorkType  @map("work_type")
  quantity       Int
  unit           WorkUnit
  /// Hours spent — the split basis when one day mixes different units.
  hours          Decimal?  @db.Decimal(5, 2)
  notes          String?   @db.VarChar(500)
  idempotencyKey String    @unique @map("idempotency_key") @db.Uuid
  recordedById   String    @map("recorded_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedById     String?   @map("voided_by_id") @db.Uuid
  voidReason     String?   @map("void_reason") @db.VarChar(300)

  workday       WorkerWorkday            @relation(fields: [workdayId], references: [id], onDelete: Restrict)
  worker        Worker                   @relation(fields: [workerId], references: [id], onDelete: Restrict)
  order         Order?                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// RESTRICT: a group with work logged against it can never be deleted.
  orderGroup    OrderGroup?              @relation(fields: [orderGroupId], references: [id], onDelete: Restrict)
  recordedBy    User                     @relation("WorkLogRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy      User?                    @relation("WorkLogVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  /// Physical pieces this work completed for a stage, when confirmed in the same submission.
  stageProgress ProductionStageProgress?

  @@index([workdayId])
  @@index([orderId])
  @@index([orderGroupId])
  @@index([workerId, createdAt])
  @@map("worker_work_logs")
}

// ───────────────────────────── Phase 5: production & partial delivery ─────────────────────────────
//
// Physical units of an order group (the order's own unit), never worker
// "prints": three kinds of records, all whole numbers, all voidable (never deleted):
//   • ProductionStageProgress — N pieces finished ONE required operation (DTF, …).
//   • ProductionReady         — N pieces confirmed finished with ALL operations
//                               (the authoritative "finished" quantity).
//   • Delivery                — N ready pieces handed to the customer.
// Per group: stage_total(op) ≤ quantity; ready ≤ min(stage totals) and ≤ quantity;
// delivered ≤ ready. Every write locks the order row, so these hold under concurrency.

model ProductionStageProgress {
  id               String         @id @default(uuid(7)) @db.Uuid
  orderId          String         @map("order_id") @db.Uuid
  /// Set for groups with a size breakdown (then every record names its size).
  orderGroupSizeId String?        @map("order_group_size_id") @db.Uuid
  orderGroupId     String         @map("order_group_id") @db.Uuid
  operation        PrintOperation
  quantity         Int
  workDate         DateTime       @map("work_date") @db.Date
  notes            String?        @db.VarChar(500)
  /// Set when confirmed together with a worker's output record (traceability only).
  workLogId        String?        @unique @map("work_log_id") @db.Uuid
  /// The design this work was for (items with designs only; older rows are
  /// item-level and stay that way — never reassigned to a design).
  designId         String?        @map("design_id") @db.Uuid
  idempotencyKey   String         @unique @map("idempotency_key") @db.Uuid
  recordedById     String         @map("recorded_by_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt         DateTime?      @map("voided_at") @db.Timestamptz(3)
  voidedById       String?        @map("voided_by_id") @db.Uuid
  voidReason       String?        @map("void_reason") @db.VarChar(300)

  order             Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderGroup        OrderGroup          @relation(fields: [orderGroupId], references: [id], onDelete: Restrict)
  orderGroupSize    OrderGroupSize?     @relation(fields: [orderGroupSizeId], references: [id], onDelete: Restrict)
  /// The operation must be one the group actually requires.
  requiredOperation OrderGroupOperation @relation(fields: [orderGroupId, operation], references: [groupId, operation], onDelete: Restrict)
  workLog           WorkerWorkLog?      @relation(fields: [workLogId], references: [id], onDelete: Restrict)
  design            OrderGroupDesign?   @relation(fields: [designId], references: [id], onDelete: Restrict)
  recordedBy        User                @relation("StageRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy          User?               @relation("StageVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([designId])
  @@index([orderGroupSizeId])
  @@index([orderGroupId, operation])
  @@index([workDate])
  @@map("production_stage_progress")
}

model ProductionReady {
  id               String    @id @default(uuid(7)) @db.Uuid
  orderId          String    @map("order_id") @db.Uuid
  /// Set for groups with a size breakdown (then every record names its size).
  orderGroupSizeId String?   @map("order_group_size_id") @db.Uuid
  orderGroupId     String    @map("order_group_id") @db.Uuid
  quantity         Int
  readyDate        DateTime  @map("ready_date") @db.Date
  notes            String?   @db.VarChar(500)
  /// The stage record saved in the same submission (single-operation groups).
  stageProgressId  String?   @unique @map("stage_progress_id") @db.Uuid
  idempotencyKey   String    @unique @map("idempotency_key") @db.Uuid
  recordedById     String    @map("recorded_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt         DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedById       String?   @map("voided_by_id") @db.Uuid
  voidReason       String?   @map("void_reason") @db.VarChar(300)

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderGroup     OrderGroup      @relation(fields: [orderGroupId], references: [id], onDelete: Restrict)
  orderGroupSize OrderGroupSize? @relation(fields: [orderGroupSizeId], references: [id], onDelete: Restrict)
  recordedBy     User            @relation("ReadyRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy       User?           @relation("ReadyVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([orderGroupSizeId])
  @@index([orderGroupId])
  @@map("production_ready")
}

model Delivery {
  id               String    @id @default(uuid(7)) @db.Uuid
  orderId          String    @map("order_id") @db.Uuid
  /// Set for groups with a size breakdown (then every record names its size).
  orderGroupSizeId String?   @map("order_group_size_id") @db.Uuid
  orderGroupId     String    @map("order_group_id") @db.Uuid
  quantity         Int
  deliveredAt      DateTime  @map("delivered_at") @db.Date
  notes            String?   @db.VarChar(500)
  idempotencyKey   String    @unique @map("idempotency_key") @db.Uuid
  recordedById     String    @map("recorded_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt         DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedById       String?   @map("voided_by_id") @db.Uuid
  voidReason       String?   @map("void_reason") @db.VarChar(300)

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderGroup     OrderGroup      @relation(fields: [orderGroupId], references: [id], onDelete: Restrict)
  orderGroupSize OrderGroupSize? @relation(fields: [orderGroupSizeId], references: [id], onDelete: Restrict)
  recordedBy     User            @relation("DeliveryRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy       User?           @relation("DeliveryVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([orderGroupSizeId])
  @@index([orderGroupId])
  @@index([deliveredAt])
  @@map("deliveries")
}

// ───────────────────────────── Garment sizes ─────────────────────────────
//
// A lightweight size breakdown per work group (e.g. S 50 · M 50 · L 50 · XL 50).
// Not a variant/SKU system: just labels and quantities that add up to the
// group's quantity. Production, ready and delivery records of a sized group
// each name their size, so every per-size balance is computed from events.
// Unsized groups (and all records created before sizes existed) keep working.

/// One design printed/embroidered on (some of) an item's pieces — e.g. a chest
/// logo in DTF and back artwork in screen print on the same 200 shirts. The
/// item's quantity is the physical count; a design's quantity is only the
/// work it needs (≤ the item quantity) and is never added to physical totals.
model OrderGroupDesign {
  id               String         @id @default(uuid(7)) @db.Uuid
  orderGroupId     String         @map("order_group_id") @db.Uuid
  position         Int
  /// «اسم الرسمة» (optional; shown as «رسمة N» when empty).
  name             String?        @db.VarChar(120)
  operation        PrintOperation
  /// Fixed placement codes (CHEST, BACK, BADGE, RIGHT_SLEEVE, LEFT_SLEEVE).
  placements       String[]       @default([])
  /// Free placements typed under «أخرى» (e.g. «تحت الرقبة»).
  customPlacements String[]       @default([]) @map("custom_placements")
  /// Pieces of the item that get this design.
  quantity         Int
  /// Planned presses per piece; 0 is a real answer (no heat press).
  pressesPerUnit   Int?           @map("presses_per_unit")
  notes            String?        @db.VarChar(500)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  orderGroup    OrderGroup                @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)
  /// RESTRICT: a design with recorded progress can't be removed.
  stageProgress ProductionStageProgress[]

  @@unique([orderGroupId, position])
  @@map("order_group_designs")
}

model OrderGroupSize {
  id           String   @id @default(uuid(7)) @db.Uuid
  orderGroupId String   @map("order_group_id") @db.Uuid
  /// Normalized label: "S", "2XL", "38", "10 سنين" (see src/lib/orders/sizes.ts).
  label        String   @db.VarChar(24)
  position     Int
  quantity     Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orderGroup    OrderGroup                @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)
  stageProgress ProductionStageProgress[]
  ready         ProductionReady[]
  deliveries    Delivery[]

  @@unique([orderGroupId, label])
  @@index([orderGroupId, position])
  @@map("order_group_sizes")
}

/// SELECTED_STAFF orders: the app user accounts (not payroll workers) that may
/// see the order, by stable user id. Rows only grant access while the order is
/// SELECTED_STAFF, and are removed when the owner picks another visibility.
model OrderAccess {
  orderId     String   @map("order_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  grantedById String   @map("granted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User  @relation("OrderAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User  @relation("OrderAccessGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)

  @@id([orderId, userId])
  @@index([userId])
  @@map("order_access")
}

// ───────────────────────────── Treasury ─────────────────────────────

enum OpeningBasis {
  /// Counted before any money moved that day: that day's payments come after it.
  START_OF_DAY
  /// Counted after the day's last movement: that day's payments are inside it.
  END_OF_DAY
}

enum FinancialAccountType {
  /// خزنة كاش
  CASH
  /// حساب بنكي
  BANK
  /// محفظة إلكترونية
  WALLET
}

/// A place where the business actually holds money. Its balance is always
/// computed: opening balance (counted by the owner as of `openingDate`) plus
/// attributed movements dated on or after `openingDate`. Never stored.
model FinancialAccount {
  id               String               @id @default(uuid(7)) @db.Uuid
  name             String               @unique @db.VarChar(80)
  type             FinancialAccountType
  currency         String               @default("EGP") @db.Char(3)
  /// The amount the owner physically counted / confirmed.
  openingBalance   Decimal              @map("opening_balance") @db.Decimal(14, 2)
  /// The day the count was made, and whether it was before any money moved
  /// that day (START_OF_DAY) or after the last movement (END_OF_DAY).
  openingCountDate DateTime             @map("opening_count_date") @db.Date
  openingBasis     OpeningBasis         @map("opening_basis")
  /// First day whose movements count AFTER the opening balance (derived:
  /// the count day for START_OF_DAY, the next day for END_OF_DAY). Money
  /// dated before it is inside the counted balance and is never attributed.
  openingDate      DateTime             @map("opening_date") @db.Date
  isActive         Boolean              @default(true) @map("is_active")
  notes            String?              @db.VarChar(300)
  createdById      String               @map("created_by_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy        User                     @relation("FinancialAccountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  orderPayments    OrderPayment[]           @relation("OrderPaymentAccount")
  outgoingPayments OutgoingPayment[]        @relation("OutgoingPaymentAccount")
  movementsFrom    TreasuryMovement[]       @relation("MovementAccount")
  movementsTo      TreasuryMovement[]       @relation("MovementToAccount")
  reconciliations  TreasuryReconciliation[]

  @@map("financial_accounts")
}

enum TreasuryMovementKind {
  /// Owner put money into the business (not revenue).
  CAPITAL_IN
  /// Owner took money out (not an expense).
  DRAWING
  /// Between two accounts: out of `accountId`, into `toAccountId`.
  TRANSFER
  /// Audited correction after a count; `direction` says which way.
  ADJUSTMENT
}

enum MoneyDirection {
  IN
  OUT
}

/// Treasury-only money movements (everything else comes from customer and
/// outgoing payments). Never edited or deleted: wrong rows are voided with a reason.
model TreasuryMovement {
  id             String               @id @default(uuid(7)) @db.Uuid
  kind           TreasuryMovementKind
  accountId      String               @map("account_id") @db.Uuid
  toAccountId    String?              @map("to_account_id") @db.Uuid
  /// For ADJUSTMENT only (CAPITAL_IN is IN, DRAWING is OUT, TRANSFER is both).
  direction      MoneyDirection?
  amount         Decimal              @db.Decimal(14, 2)
  movementDate   DateTime             @map("movement_date") @db.Date
  notes          String?              @db.VarChar(500)
  idempotencyKey String               @unique @map("idempotency_key") @db.Uuid
  recordedById   String               @map("recorded_by_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt       DateTime?            @map("voided_at") @db.Timestamptz(3)
  voidedById     String?              @map("voided_by_id") @db.Uuid
  voidReason     String?              @map("void_reason") @db.VarChar(300)

  account    FinancialAccount  @relation("MovementAccount", fields: [accountId], references: [id], onDelete: Restrict)
  toAccount  FinancialAccount? @relation("MovementToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  recordedBy User              @relation("TreasuryMovementRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy   User?             @relation("TreasuryMovementVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([accountId, movementDate])
  @@index([toAccountId, movementDate])
  @@map("treasury_movements")
}

/// An owner count of an account compared with the system balance at that moment.
model TreasuryReconciliation {
  id            String   @id @default(uuid(7)) @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  countDate     DateTime @map("count_date") @db.Date
  countedAmount Decimal  @map("counted_amount") @db.Decimal(14, 2)
  systemBalance Decimal  @map("system_balance") @db.Decimal(14, 2)
  notes         String?  @db.VarChar(500)
  recordedById  String   @map("recorded_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  account    FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  recordedBy User             @relation("ReconciliationRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([accountId, countDate])
  @@map("treasury_reconciliations")
}

/// Owner's explicit split of one item's value across departments. Amounts are
/// exact piasters and must add up to the item's line total (quantity × unit
/// price); if the price changes later, the split is flagged as stale and the
/// item's value is treated as not reliably allocatable until it is re-saved.
model OrderGroupValueShare {
  orderGroupId String   @map("order_group_id") @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  amount       Decimal  @db.Decimal(12, 2)
  setById      String   @map("set_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  orderGroup OrderGroup @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  setBy      User       @relation("ValueShareSetBy", fields: [setById], references: [id], onDelete: Restrict)

  @@id([orderGroupId, departmentId])
  @@index([departmentId])
  @@map("order_group_value_shares")
}

/// «منتج جاهز» shortcuts in the order form. Names only: no price, no stock.
model ProductPreset {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique @db.VarChar(80)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User? @relation("PresetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("product_presets")
}

enum ItemPricingBasis {
  UNIT
  LINEAR_METER
  /// Raw materials sold by weight / length / volume: measuredQuantity (3 decimals) × unitPrice.
  MEASURED
}

enum CostReviewStatus {
  PENDING
  IN_PROGRESS
  CLOSED
  NEEDS_REVIEW
}

/// Audit trail of an amended cost entry: the full before/after and the reason.
model OrderCostRevision {
  id          String   @id @default(uuid(7)) @db.Uuid
  orderCostId String   @map("order_cost_id") @db.Uuid
  /// The cost's version AFTER this change.
  version     Int
  before      Json
  after       Json
  reason      String   @db.VarChar(300)
  changedById String   @map("changed_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  orderCost OrderCost @relation(fields: [orderCostId], references: [id], onDelete: Restrict)
  changedBy User      @relation("CostRevisionBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@unique([orderCostId, version])
  @@map("order_cost_revisions")
}

/// Owner settings per work kind (e.g. the default roll width of DTF / vinyl).
/// No value is assumed: an empty setting means the width is typed per item.
model WorkKindSetting {
  workKind    String   @id @map("work_kind") @db.VarChar(40)
  rollWidthMm Int?     @map("roll_width_mm")
  updatedById String   @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User @relation("WorkKindSettingBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("work_kind_settings")
}

/// A fixed monthly expense (rent, salaries, internet…). It never creates
/// money movements by itself: the owner generates the month's expense rows
/// explicitly (idempotent — one per template per month), then pays them as usual.
model RecurringExpense {
  id          String          @id @default(uuid(7)) @db.Uuid
  category    ExpenseCategory
  description String          @db.VarChar(300)
  amount      Decimal         @db.Decimal(12, 2)
  /// Day of the month the expense is dated (1–28, so every month has it).
  dayOfMonth  Int             @map("day_of_month")
  /// First and (optional) last month it applies to, "YYYY-MM".
  startMonth  String          @map("start_month") @db.Char(7)
  endMonth    String?         @map("end_month") @db.Char(7)
  isActive    Boolean         @default(true) @map("is_active")
  createdById String          @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User             @relation("RecurringExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  expenses  GeneralExpense[]

  @@map("recurring_expenses")
}

enum MonthlyCloseStatus {
  CONFIRMED
  REOPENED
}

/// The owner's review of one month («قفل الشهر»). It does NOT lock any data
/// and posts nothing: it stores what the owner confirmed (a snapshot of the
/// computed figures), so later changes to that month are visible as a
/// difference. Reopening needs a reason; every step is kept in events.
model MonthlyClose {
  id            String             @id @default(uuid(7)) @db.Uuid
  /// "YYYY-MM"
  month         String             @unique @db.Char(7)
  status        MonthlyCloseStatus
  /// Revenue recognition basis the snapshot was computed with.
  basis         String             @db.VarChar(20)
  snapshot      Json
  notes         String?            @db.VarChar(1000)
  /// Bumped on every confirm / reopen (optimistic concurrency).
  version       Int                @default(0)
  confirmedById String?            @map("confirmed_by_id") @db.Uuid
  confirmedAt   DateTime?          @map("confirmed_at") @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  confirmedBy User?               @relation("MonthlyCloseConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  events      MonthlyCloseEvent[]

  @@map("monthly_closes")
}

model MonthlyCloseEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  closeId   String   @map("close_id") @db.Uuid
  /// CONFIRMED | REOPENED
  action    String   @db.VarChar(20)
  reason    String?  @db.VarChar(500)
  snapshot  Json
  byId      String   @map("by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  close MonthlyClose @relation(fields: [closeId], references: [id], onDelete: Restrict)
  by    User         @relation("MonthlyCloseEventBy", fields: [byId], references: [id], onDelete: Restrict)

  @@index([closeId, createdAt])
  @@map("monthly_close_events")
}
