# Copy to .env and adjust. Never commit .env.

# PostgreSQL connection string.
# Local development (docker compose up -d) uses the values from docker-compose.yml:
DATABASE_URL="postgresql://benuuprint:change-me-local-dev@localhost:5432/benuuprint?schema=public"

# Optional: separate database used by integration tests (npm run test:integration).
# It is wiped by the tests — never point this at real data.
# TEST_DATABASE_URL="postgresql://benuuprint:change-me-local-dev@localhost:5432/benuuprint_test?schema=public"

# Optional: force the session cookie's Secure flag. Defaults to true when
# NODE_ENV=production. Set to "false" ONLY to try a production build over plain
# http on your own machine. Never set it to false on the VPS.
# SESSION_COOKIE_SECURE="true"
